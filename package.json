    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "sass": "^1.107.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.15.0"
